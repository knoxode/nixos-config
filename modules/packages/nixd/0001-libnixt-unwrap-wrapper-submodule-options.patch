+/// \brief Check if \p Type is a type that wraps a submodule.
+///
+/// `nullOr (submodule ...)`, `either (submodule ...) str`, `oneOf` and
+/// `coercedTo` are not named "submodule", but they forward `getSubOptions` to
+/// the type they wrap.  Collection types (`attrsOf`, `listOf`, ...) forward it
+/// as well, but expect one more path component (an attribute name or a list
+/// index), so they are handled separately in `selectOptions`.
+bool isTypeSubmoduleWrapper(nix::EvalState &State, nix::Value &Type) {
+  if (!checkField(State, Type, "name", "nullOr") &&
+      !checkField(State, Type, "name", "either") &&
+      !checkField(State, Type, "name", "oneOf") &&
+      !checkField(State, Type, "name", "coercedTo"))
+    return false;
+  return getField(State, Type, "getSubOptions").has_value();
+}
