+/// \brief Check if \p Options is an option set with at least one option.
+bool hasOptionFields(nix::EvalState &State, nix::Value &Options) {
+  State.forceValue(Options, nix::noPos);
+  if (Options.type() != nix::ValueType::nAttrs)
+    return false;
+  for (const auto *Attr : Options.attrs()->lexicographicOrder(State.symbols))
+    if (State.symbols[Attr->name] != "_module")
+      return true;
+  return false;
+}
+
+/// \brief Replace \p V with the option set of the submodule it declares, if it
+/// declares one.
+void mangleSubOptions(nix::EvalState &State, nix::Value &V) {
+  nix::Value *Type = trySelectAttr(State, V, nix::EvalState::s.type);
+  if (!Type)
+    return;
+
+  const bool IsSubmodule = isTypeSubmodule(State, *Type);
+  if (!IsSubmodule && !isTypeSubmoduleWrapper(State, *Type))
+    return;
+
+  try {
+    nix::Value Options = getSubOptions(State, *Type);
+    // Wrappers over plain types (`nullOr str`, `either str int`, ...) expose an
+    // empty option set.  Keep the option itself in that case, so hover can
+    // still describe it.
+    if (!IsSubmodule && !hasOptionFields(State, Options))
+      return;
+    V = Options;
+  } catch (std::exception &) {
+    // The type advertises sub-options but cannot provide them without
+    // arguments; keep the value as it is.
+  }
+}
