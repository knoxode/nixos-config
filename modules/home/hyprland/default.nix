{
  config,
  host,
  lib,
  pkgs,
  ...
}: let
  variables = import ../../../hosts/${host}/variables.nix;

  hyprland = variables.hyprland;

  hyprDir = "/home/shaiikura/alexos/modules/home/hyprland";

  files = [
    "helpers"
    "systems"
    "events"
    "diagnostics"
    "machine_specific"
    "animations.lua"
    "appearance.lua"
    "binds.lua"
    "env.lua"
    "exec.lua"
    "gpu.lua"
    "hyprland.lua"
    "layouts.lua"
    "misc.lua"
    "permissions.lua"
    "shared.lua"
    "windowrules.lua"
    "workspaces.lua"
  ];

  # Host-specific data, generated from hosts/<host>/variables.nix.
  # These are store paths, not out-of-store symlinks: changes take
  # effect on the next switch, like the rest of the Nix configuration.
  luaStr = s: ''"${s}"'';
  luaList = xs: "{ ${lib.concatStringsSep ", " (map luaStr xs)} }";

  keyboardsTable =
    "{\n"
    + lib.concatStringsSep ",\n" (
      lib.mapAttrsToList (layout: names: "  ${layout} = ${luaList names}") hyprland.keyboards
    )
    + "\n}";

  hostLua = pkgs.writeText "hyprland-host.lua" ''
    --- Host-specific data, generated by Nix from hosts/${host}/variables.nix.
    return {
      hostname = "${host}",
      latitude = ${toString hyprland.latitude},
      longitude = ${toString hyprland.longitude},
    }
  '';

  devicesLua = pkgs.writeText "hyprland-devices.lua" ''
    --- Per-host keyboard layout assignments, generated by Nix from
    --- hosts/${host}/variables.nix.
    local keyboards = ${keyboardsTable}

    for layout, device_names in pairs(keyboards) do
      for _, device_name in ipairs(device_names) do
        hl.device({
          name = device_name,
          kb_layout = layout,
        })
      end
    end
  '';
in {
  imports = [
    ./hypridle.nix
    ./hyprland.nix
  ];

  home.file =
    builtins.listToAttrs (
      map (file: {
        name = ".config/hypr/${file}";
        value.source = config.lib.file.mkOutOfStoreSymlink "${hyprDir}/${file}";
      })
      files
    )
    // {
      ".config/hypr/host.lua".source = hostLua;
      ".config/hypr/devices.lua".source = devicesLua;
    };
}
